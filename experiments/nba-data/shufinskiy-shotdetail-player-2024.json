{
  "build": {
    "encoding": "utf-8-sig",
    "group_by": ["TEAM_ID", "PLAYER_ID", "PLAYER_NAME"],
    "metrics": [
      {"column": "GAME_ID", "name": "games", "operation": "distinct_count"},
      {"name": "field_goal_attempts", "operation": "count"},
      {
        "name": "field_goals_made",
        "operation": "count",
        "where": {"SHOT_MADE_FLAG": {"truthy": true}}
      },
      {
        "name": "rim_attempts",
        "operation": "count",
        "where": {
          "SHOT_ZONE_BASIC": {"in": ["Restricted Area", "In The Paint (Non-RA)"]}
        }
      },
      {
        "name": "rim_made",
        "operation": "count",
        "where": {
          "SHOT_MADE_FLAG": {"truthy": true},
          "SHOT_ZONE_BASIC": {"in": ["Restricted Area", "In The Paint (Non-RA)"]}
        }
      },
      {
        "name": "midrange_attempts",
        "operation": "count",
        "where": {"SHOT_ZONE_BASIC": {"equals": "Mid-Range"}}
      },
      {
        "name": "midrange_made",
        "operation": "count",
        "where": {
          "SHOT_MADE_FLAG": {"truthy": true},
          "SHOT_ZONE_BASIC": {"equals": "Mid-Range"}
        }
      },
      {
        "name": "three_attempts",
        "operation": "count",
        "where": {"SHOT_TYPE": {"equals": "3PT Field Goal"}}
      },
      {
        "name": "three_made",
        "operation": "count",
        "where": {
          "SHOT_MADE_FLAG": {"truthy": true},
          "SHOT_TYPE": {"equals": "3PT Field Goal"}
        }
      }
    ],
    "resource_id": "shotdetail"
  },
  "dataset_id": "shufinskiy-shotdetail-2024",
  "provider": "shufinskiy/nba_data shotdetail player projection",
  "resources": [
    {
      "filename": "shotdetail_2024.tar.xz",
      "resource_id": "shotdetail",
      "sha256": "950100f9c84fe750ae2ac8eaeb82d24cdfb9f60a9ed04ceaa66f64789d7c216e",
      "url": "https://github.com/shufinskiy/nba_data/raw/main/datasets/shotdetail_2024.tar.xz"
    }
  ],
  "schema_version": 1,
  "season": "2024-25",
  "terms_note": "Free personal research only; preserve upstream attribution and do not redistribute raw NBA-derived data."
}
