{
  "build": {
    "encoding": "utf-8-sig",
    "metrics": [
      {
        "column": "GAME_ID",
        "name": "games",
        "operation": "distinct_count"
      },
      {
        "column": "TEAM_ID",
        "name": "teams",
        "operation": "distinct_count"
      },
      {
        "name": "field_goal_attempts",
        "operation": "count"
      },
      {
        "name": "field_goals_made",
        "operation": "count",
        "where": {
          "SHOT_MADE_FLAG": {
            "truthy": true
          }
        }
      },
      {
        "name": "three_point_attempts",
        "operation": "count",
        "where": {
          "SHOT_TYPE": {
            "equals": "3PT Field Goal"
          }
        }
      },
      {
        "name": "three_points_made",
        "operation": "count",
        "where": {
          "SHOT_MADE_FLAG": {
            "truthy": true
          },
          "SHOT_TYPE": {
            "equals": "3PT Field Goal"
          }
        }
      },
      {
        "name": "restricted_area_attempts",
        "operation": "count",
        "where": {
          "SHOT_ZONE_BASIC": {
            "equals": "Restricted Area"
          }
        }
      },
      {
        "name": "restricted_area_made",
        "operation": "count",
        "where": {
          "SHOT_MADE_FLAG": {
            "truthy": true
          },
