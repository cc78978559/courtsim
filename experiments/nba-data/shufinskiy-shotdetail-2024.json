            "equals": "Restricted Area"
          }
        }
      },
      {
        "name": "paint_non_ra_attempts",
        "operation": "count",
        "where": {
          "SHOT_ZONE_BASIC": {
            "equals": "In The Paint (Non-RA)"
          }
        }
      },
      {
        "name": "paint_non_ra_made",
        "operation": "count",
        "where": {
          "SHOT_MADE_FLAG": {
            "truthy": true
          },
          "SHOT_ZONE_BASIC": {
            "equals": "In The Paint (Non-RA)"
          }
        }
      },
      {
        "name": "mid_range_attempts",
        "operation": "count",
        "where": {
          "SHOT_ZONE_BASIC": {
            "equals": "Mid-Range"
          }
        }
      },
      {
        "name": "mid_range_made",
        "operation": "count",
        "where": {
          "SHOT_MADE_FLAG": {
            "truthy": true
          },
          "SHOT_ZONE_BASIC": {
            "equals": "Mid-Range"
          }
        }
      },
      {
        "name": "corner_three_attempts",
        "operation": "count",
        "where": {
          "SHOT_ZONE_BASIC": {
            "in": [
              "Left Corner 3",
              "Right Corner 3"
